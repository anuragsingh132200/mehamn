# Fictional case study. Copy to .env at repository root.
POSTGRES_PASSWORD=mira_local_only
DATABASE_URL=postgresql+psycopg://mira:mira_local_only@localhost:5432/mira
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# OpenAI is the only supported conversation provider; there is no offline parser.
LLM_MODE=openai
# Set a long random value. It is never sent to the guest UI or bundled in JS.
ADMIN_TOKEN=replace-with-a-long-random-demo-admin-token
CORS_ORIGIN=http://localhost:3000
QUOTE_MINUTES=15
HOLD_MINUTES=10
RATE_LIMIT_PER_MINUTE=30

# Bounded conversation context and execution
RECENT_MESSAGE_WINDOW=12
CONTEXT_MESSAGE_CHARS=2000
CONTEXT_TOOL_WINDOW=12
MAX_MODEL_CALLS=4
MAX_PLANNING_ROUNDS=2
MAX_AGENT_TOOLS=12
MODEL_TIMEOUT_SECONDS=15
AGENT_TIMEOUT_SECONDS=55
MODEL_MAX_OUTPUT_TOKENS=3000
